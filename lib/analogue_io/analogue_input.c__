#include <stdlib.h>
#include <string.h>

#include "adc.h"

static float calc_voltage(uint32_t raw, float vdda) {
    return (float)raw * vdda / 4095;
}

static void moving_average_add(AnalogueInput_t* p, float newValue) {
    if (p->MovingAverage.initialized) {
        p->MovingAverage.value -= p->MovingAverage.value / (float)p->MovingAverage.smoothWindow;
        p->MovingAverage.value += newValue / (float)p->MovingAverage.smoothWindow;
    } else {
        p->MovingAverage.value = newValue;
        p->MovingAverage.initialized = true;
    }
}

AnalogueInput_t*
analogue_input_init(uint32_t smoothWindow, uint32_t pollPeriodMs, uint8_t id) {
    AnalogueInput_t* p = (AnalogueInput_t*)malloc(sizeof(AnalogueInput_t));
    if (p == NULL) return NULL;
    memset(p, 0x00, sizeof(AnalogueInput_t));
    p->id = id;
    p->MovingAverage.smoothWindow = smoothWindow;
    p->MovingAverage.initialized = false;
    p->MovingAverage.value = 0.0f;
    p->pollPeriod = pollPeriodMs;
    if (analogue_input_ll_init(p) == false) {
        return NULL;
    }
    p->State = AnalogueInputState_Idle;
    return p;
}

void
analogue_input_run(AnalogueInput_t* p) {
    if (p == NULL) return;
    switch (p->State) {
        case AnalogueInputState_Idle:
            if (analogue_input_ll_get_tick() - p->timestamp >= p->pollPeriod) {
                p->timestamp = analogue_input_ll_get_tick();
                if (analogue_input_ll_start_conv(p)) {
                    p->State = AnalogueInputState_ConversionWaiting;
                }
            }
            break;

        case AnalogueInputState_ConversionWaiting:
            uint32_t rawValue = 0;
            if (analogue_input_ll_get_value(p, &rawValue)) {
                float newValue = calc_voltage(rawValue, 3.3f);
                moving_average_add(p, newValue);
                p->timestamp = analogue_input_ll_get_tick();
                p->State = AnalogueInputState_Idle;
            }
            break;

        default:
            break;
    }
}

float
analogue_input_get_value(AnalogueInput_t* p) {
    return p->MovingAverage.value;
}

__attribute__((weak)) bool
analogue_input_ll_init(AnalogueInput_t* p) {
    (void)p;
    return false;
}

__attribute__((weak)) bool
analogue_input_ll_start_conv(AnalogueInput_t* p) {
    (void)p;
    return false;
}

__attribute__((weak)) bool
analogue_input_ll_get_value(AnalogueInput_t* p, uint32_t* val) {
    (void)p;
    (void)val;
    return false;
}

__attribute__((weak)) bool
analogue_input_ll_get_tick(uint32_t* val) {
    (void)val;
    return false;
}
